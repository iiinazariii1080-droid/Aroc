# ---- Symovo ----
SYMOVO_CAR_IP=192.168.1.100
SYMOVO_ROBOT_NUMBER=15
SYMOVO_TIMEOUT_SECONDS=10
SYMOVO_ALLOW_INVALID_CERTS=true
# If true, backend will auto-try to enable drive mode when state_flags.drive_ready=false before starting navigation.
# Keep false unless you fully understand the safety implications.
SYMOVO_AUTO_SET_DRIVE_MODE=true
SYMOVO_AUTO_SET_DRIVE_MODE_WAIT_S=1.0
# If true, backend will clear ALL transports on the controller at startup (destructive).
# Use with caution: this will remove active/queued transports from Symovo.
SYMOVO_CLEAR_TRANSPORTS_ON_STARTUP=false
# If true, backend will clear ALL transports on Symovo controller before each new navigateTo (destructive).
SYMOVO_CLEAR_TRANSPORTS_BEFORE_NAVIGATE=false

# If true, when progress reaches ~99% and robot is within SYMOVO_ARRIVAL_DIST_M of goal for SYMOVO_ARRIVAL_DWELL_S,
# backend will force ARRIVED even if Symovo transport never switches to FINISHED.
SYMOVO_FORCE_ARRIVAL_ON_PROXIMITY=true
SYMOVO_ARRIVAL_DIST_M=0.25
SYMOVO_ARRIVAL_DWELL_S=2.5

# ---- Charger workflow ----
# If navigateTo target_id matches CHARGER_TARGET_NAME, backend will activate (enable)
# the charging station with name CHARGER_STATION_NAME after navigation arrives.
CHARGER_ACTIVATION_ENABLED=true
CHARGER_TARGET_NAME=CHARGER
CHARGER_STATION_NAME=charger

# ---- Service ----
SERVICE_HOST=0.0.0.0
SERVICE_PORT=7905
LOG_LEVEL=INFO

# ---- Teleop (джойстик/клавиатура) ----
# Отдельный HTTP‑сервер в потоке: PUT/POST /move/speed → Symovo /v0/agv/{id}/move/speed
TELEOP_ENABLED=true
TELEOP_HOST=0.0.0.0
TELEOP_PORT=7906

# ---- AE.HUB ----
ROBOT_ID=fahrdummy-01

# ---- MQTT ----
MQTT_BROKER_HOST=your-broker-host
MQTT_BROKER_PORT=8883
MQTT_USERNAME=bridge_user
MQTT_PASSWORD=changeme
MQTT_USE_TLS=true
# Path to CA certificate file (e.g., ca.crt). If not set, auto-detects ca.crt in project root.
# MQTT_CA_CERT=ca.crt
# Set to true to disable SSL certificate verification (for self-signed certs, testing only).
# Only used if MQTT_CA_CERT is not set.
MQTT_TLS_INSECURE=false
MQTT_CLIENT_ID=aehub_backend_fahrdummy-01

# Events topic prefix (optional)
# MQTT_EVENTS_PREFIX=aroc/robot/{robot_id}/events

# ---- Rates / timeouts ----
NAVIGATION_STATUS_HZ=1
POSITION_STATUS_HZ=2
TRANSPORT_WATCH_TIMEOUT=30
# Keep ARRIVED visible for a short time before switching to IDLE (prevents flicker).
NAVIGATION_TERMINAL_HOLD_S=3.0

# ---- Health reliability thresholds ----
# Degraded mode is reported in /livez, /readyz and /ops/reliabilityz when thresholds are exceeded.
# Recommended dev/stage/prod presets: docs/RELIABILITY_RUNBOOK.md
HEALTH_EVENTBUS_DROP_MAX=0
HEALTH_PERSISTENCE_DROP_MAX=0
HEALTH_MQTT_EVENT_PUBLISH_FAIL_MAX=0

# Latency degradation thresholds (ms) with minimum sample guard.
HEALTH_LATENCY_MIN_SAMPLES=10
HEALTH_MQTT_EVENT_LATENCY_MAX_MS=1500
HEALTH_SYMOVO_LONGPOLL_LATENCY_MAX_MS=35000
HEALTH_PERSISTENCE_WRITE_LATENCY_MAX_MS=250

# Rate-based degradation thresholds (rolling 60s window, events per second)
HEALTH_EVENTBUS_DROP_RATE_MAX_PER_S=0.01
HEALTH_PERSISTENCE_DROP_RATE_MAX_PER_S=0.005
HEALTH_MQTT_EVENT_FAILURE_RATE_MAX_PER_S=0.01

# ---- Persistence ----
PERSISTENCE_ENABLED=true
PERSISTENCE_PATH=data/state.json
