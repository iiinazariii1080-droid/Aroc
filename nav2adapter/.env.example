# nav2adapter — environment configuration
# Copy to .env and fill in real values

# --- MQTT Broker (AE.HUB) ---
MQTT_BROKER_HOST=82.165.177.194
MQTT_BROKER_PORT=8883
MQTT_USERNAME=bridge_user
MQTT_PASSWORD=CHANGE_ME
MQTT_USE_TLS=true

# --- Robot Identity ---
ROBOT_ID=fahrdummy-01

# --- Symovo AGV ---
SYMOVO_CAR_IP=192.168.1.100
SYMOVO_AUTO_SET_DRIVE_MODE=true
SYMOVO_AUTO_SET_DRIVE_MODE_WAIT_S=1.0
SYMOVO_CLEAR_TRANSPORTS_ON_STARTUP=true
SYMOVO_CLEAR_TRANSPORTS_BEFORE_NAVIGATE=true
SYMOVO_FORCE_ARRIVAL_ON_PROXIMITY=true
SYMOVO_ARRIVAL_DIST_M=0.25
SYMOVO_ARRIVAL_DWELL_S=2.5

# --- Status Publishing ---
POSITION_STATUS_HZ=0.5
NAVIGATION_TERMINAL_HOLD_S=3.0

# --- Charger ---
CHARGER_ACTIVATION_ENABLED=true
CHARGER_TARGET_NAME=CHARGER

# --- Persistence ---
PERSISTENCE_ENABLED=true
PERSISTENCE_PATH=data/state.json
