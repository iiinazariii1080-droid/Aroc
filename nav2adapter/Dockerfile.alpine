# Легкий Dockerfile на базе Alpine
FROM python:3.11-alpine

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Установка системных зависимостей
RUN apk add --no-cache \
    curl \
    ca-certificates

# Copy requirements and install
COPY requirements.txt ./
RUN pip install --upgrade pip && pip install -r requirements.txt

# Copy app
COPY . ./

# Non-root user (best practice)
RUN adduser -D -u 10001 appuser && chown -R appuser:appuser /app
USER appuser

# Default envs
ENV SERVICE_HOST=0.0.0.0 \
    SERVICE_PORT=7905 \
    LOG_LEVEL=info \
    ROBOT_POSITIONS_DB_PATH=/app/data/database.db

EXPOSE 7905

HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=3 \
  CMD curl -fsS "http://localhost:${SERVICE_PORT}/livez" || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "7905", "--log-level", "info"]

