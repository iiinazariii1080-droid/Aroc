# Альтернативный Dockerfile для локальной сборки
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Copy requirements and install
COPY requirements.txt ./
RUN pip install --upgrade pip && pip install -r requirements.txt

# Copy app
COPY . ./

# Non-root user
RUN useradd -m -u 10001 appuser && \
    chown -R appuser:appuser /app

# Default envs
ENV SERVICE_HOST=0.0.0.0 \
    SERVICE_PORT=7905 \
    LOG_LEVEL=info \
    ROBOT_POSITIONS_DB_PATH=/app/data/database.db \
    PERSISTENCE_PATH=/app/data/state.json

EXPOSE 7905 7906

HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=3 CMD curl -fsS http://localhost:${SERVICE_PORT}/livez || exit 1

USER appuser
CMD ["python", "main.py"]

