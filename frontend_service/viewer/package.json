{
  "name": "arm3d-viewer",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Industrial-grade 3D robot arm viewer — Vite + TypeScript + Three.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "three": "0.160.1"
  },
  "devDependencies": {
    "@types/three": "^0.160.0",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
