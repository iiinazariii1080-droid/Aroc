general: {
  configs_folder = "/opt/janus/etc/janus"
  plugins_folder = "/opt/janus/lib/janus/plugins"
  transports_folder = "/opt/janus/lib/janus/transports"
  server_name = "color-node"
  debug_level = 1
  debug_timestamps = true
  session_timeout = 60
  reclaim_session_timeout = 60
  admin_secret = "__JANUS_ADMIN_SECRET__"
}

# BEGIN NAT AUTO
nat: {
  ice_tcp = false
  full_trickle = true
  ignore_mdns = true
  ice_ignore_list = [ "docker", "veth", "lo", "vmnet", "tailscale" ]
  keep_private_host = true

  stun_server = "82.165.177.194"
  stun_port   = 3478

  turn_server = "82.165.177.194"
  turn_port   = 3478
  turn_type   = "tcp"
  turn_user   = "webrtc"
  turn_pwd    = "__TURN_PWD__"

  nat_1_1_mapping = "87.156.23.54"
  min_port = 40000
  max_port = 41000
}
# END NAT AUTO

media: {
  rtp_port_range = "5002-5120"
  no_media_timer = 30
  dtls_mtu = 1200
  slowlink_threshold = 50
}
