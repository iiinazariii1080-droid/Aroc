general : 
{
  enabled = "true";
  json = "true";
  load_all = "true";
  configs_folder = "/opt/janus/etc/janus/streams.d";
  allow_persistent = "true";
  admin_key = "stream-admin-123";
};
rgb-rtp : {
    type = "rtp";
    id = "1305";
    description = "H264 via RTP push";
    secret = "changeme";

    videobitrate = 0
    videobufferkf = true
    videosimulcast = false
    
    media = (
        {
            type = "video";
            mid = "v";
            label = "video";
            port = "5004";
            rtcpport = "5005";
            pt = "96";
            codec = "h264"
            fmtp = "profile-level-id=42e01f;packetization-mode=1;level-asymmetry-allowed=1";
            iface = "127.0.0.1";
        }
    );
};
