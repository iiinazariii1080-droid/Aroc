# ============================================================================
# Robot Platform — Environment Variables
# ============================================================================
# Copy to .env and fill in actual values.
# .env is gitignored — never commit secrets.
# ============================================================================

# ── Network Topology ────────────────────────────────────────────────────────
# LAN IP of the host machine running the services
HOST_LAN_IP=192.168.1.10

# ── Physical Devices (LAN) ─────────────────────────────────────────────────
XARM_IP=192.168.1.220
IGUS_MOTOR_IP=192.168.1.230
IGUS_MOTOR_PORT=502
DEPTH_CAMERA_IP=192.168.1.55
SYMOVO_CAR_IP=192.168.1.100

# ── MQTT Broker ─────────────────────────────────────────────────────────────
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=true

# ── WebRTC / TURN ───────────────────────────────────────────────────────────
TURN_HOST=82.165.177.194
TURN_PORT=3478
TURN_USER=webrtc
TURN_PASS=
TURN_SHARED_SECRET=

# ── Service URL Overrides (optional — defaults use HOST_LAN_IP + port) ─────
# Uncomment to override the auto-generated URL for a service.
# IGUS_SERVICE_URL=http://192.168.1.10:8101
# XARM_SERVICE_URL=http://192.168.1.10:8102
# ROBOT_SERVICE_URL=http://192.168.1.10:8110
# SYMOVO_SERVICE_URL=http://192.168.1.10:7905
# MQTT_SERVICE_URL=http://192.168.1.10:7900
# API_GATEWAY_URL=http://192.168.1.10:8201
# COLOR_CAMERA_SERVICE_URL=http://192.168.1.10:8900
# DEPTH_PROXY_SERVICE_URL=http://192.168.1.10:9000
# FRONTEND_SERVICE_URL=http://192.168.1.10:8401

# ── xARM WebSocket ──────────────────────────────────────────────────────────
XARM_WS_URL=ws://192.168.1.220:18333/ws

# ── API Gateway ─────────────────────────────────────────────────────────────
PUBLIC_HOST=192.168.1.10

# ── Hub Auth (optional) ─────────────────────────────────────────────────────
# HUB_BASE_URL=
# HUB_ROBOT_ID=
# HUB_API_KEY=

# ── Robot Identity ──────────────────────────────────────────────────────────
ROBOT_ID=robot-01
SYMOVO_ROBOT_ID=fahrdummy-01

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── App Environment ─────────────────────────────────────────────────────────
APP_ENV=dev
