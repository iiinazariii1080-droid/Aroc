# MQTT Command Service Configuration

# --- MQTT Broker ---
# MQTT_BROKER=localhost
# MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASS=
# MQTT_USE_TLS=false

# --- API Server ---
# API_ENABLED=true
# API_HOST=0.0.0.0
# API_PORT=7900

# --- Authentication ---
# AUTH_DISABLED=false              # Set to true to bypass ALL auth (dev/test only!)
# DISABLE_AUTH_FOR_CONFIG=false   # Set to true to allow anonymous access to /config/broker
# EMERGENCY_API_KEY=              # Set to override default emergency key; empty to disable

# --- Storage ---
# CONFIG_DB_PATH=./data/config.db  # SQLite DB path (:memory: for tests)

# --- Certificates ---
# CERT_STORAGE_DIR=./certs

# --- Logging ---
# LOG_LEVEL=INFO
# JSON_LOGS=false
# LOG_FILE=

# --- Rate Limiting ---
# RATE_LIMIT_ENABLED=false

# --- Security ---
# HMAC_SECRET=                    # REQUIRED for production (random string for HMAC key derivation)

# --- Network ---
# LOCAL_IP=192.168.1.10
# IS_REMOTE=true
# REMOTE_ADDRESS=api.techvisioncloud.pl/api/v1
# DEPTH_CAMERA_IP=                # Defaults to LOCAL_IP if unset

# --- Telemetry ---
# ROBOT_ID=ROBOT_01
# POLL_INTERVAL_SECONDS=5
# HTTP_TIMEOUT_SECONDS=2
# WEBSOCKET_CHECK_TIMEOUT=2.0
# WEBSOCKET_CHECK_INTERVAL=10.0
# WEBSOCKET_TLS_INSECURE=false
# JANUS_WS_DEPTH=                # Auto-derived from IS_REMOTE + REMOTE_ADDRESS if unset
# JANUS_WS_COLOR=                # Auto-derived from IS_REMOTE + REMOTE_ADDRESS if unset

# --- Service URLs (overrides) ---
# ROBOT_SERVICE_URL=http://localhost:8110/api/v1/robot
# IGUS_SERVICE_URL=http://localhost:8110/api/v1/igus
# XARM_SERVICE_URL=http://localhost:8110/api/v1/xarm
# SYMOVO_SERVICE_URL=http://localhost:8110/api/v1/symovo
# SERVICE_MAP_JSON=               # Raw JSON override for service map

# --- HUB ---
# HUB_BASE_URL=
# HUB_ROBOT_ID=
# HUB_API_KEY=
